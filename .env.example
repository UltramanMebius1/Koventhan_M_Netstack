# This service needs NO secrets to run: sessions are opaque random tokens
# (no signing key) and there is no pepper/API key. Everything below is an
# optional tuning knob with a safe default. Copy to .env (git-ignored) and
# load it with:  set -a; source .env; set +a

DATABASE_PATH=records.db

# Session lifetime (absolute, not sliding)
SESSION_TTL_SECONDS=3600

# Per-account login throttling
MAX_FAILED_LOGINS=5
FAILURE_WINDOW_SECONDS=900
LOCKOUT_SECONDS=900
MAX_LOCKOUT_SECONDS=86400

# Request size cap in bytes (oversized bodies are rejected with 400)
MAX_BODY_BYTES=131072

# scrypt cost. The service refuses to start with SCRYPT_N below 2**14.
SCRYPT_N=32768
SCRYPT_R=8
SCRYPT_P=3
